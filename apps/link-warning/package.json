{
  "name": "@link/link-warning",
  "type": "module",
  "version": "1.0.0",
  "private": true,
  "description": "两山智联云",
  "author": "link",
  "engines": {
    "node": ">=18.17.0"
  },
  "scripts": {
    "dev": "cross-env NODE_OPTIONS=--max_old_space_size=8192 NODE_ENV=development rsbuild dev --mode=development",
    "dev:fast": "cross-env NODE_OPTIONS=--max_old_space_size=8192 NODE_ENV=development FAST_DEV=true rsbuild dev --mode=development",
    "linkserve": "cross-env NODE_OPTIONS=--max_old_space_size=8192 NODE_ENV=linkserve FAST_DEV=true  rsbuild dev --mode=development",
    "build": "cross-env NODE_OPTIONS=--max_old_space_size=16384 NODE_ENV=production rsbuild build --config-loader native --mode=production",
    "linkserve:lite": "cross-env NODE_OPTIONS=--max_old_space_size=8192 NODE_ENV=linkserve FAST_DEV=true TASK=lite rsbuild dev --mode=development",
    "build:lite": "cross-env NODE_OPTIONS=--max_old_space_size=16384 NODE_ENV=production TASK=lite rsbuild build --config-loader native --mode=production",
    "preview": "rsbuild preview",
    "lint": "eslint --cache --cache-location=node_modules/.cache/.eslint-cache src/",
    "lint:fix": "eslint --fix --cache --cache-location=node_modules/.cache/.eslint-cache src/",
    "clean:all": "rm -rf node_modules/.cache node_modules dist yarn.lock",
    "clean:cache": "rimraf .rsbuild-cache",
    "devs": "npm run clean && npm run dev"
  },
  "dependencies": {
    "@chenfengyuan/vue-qrcode": "^1.0.2",
    "@liveqing/liveplayer": "^2.4.1",
    "@tanstack/query-core": "^4.33.0",
    "@tanstack/vue-query": "^4.33.0",
    "@vueuse/core": "11.1.0",
    "autoprefixer": "^10.4.20",
