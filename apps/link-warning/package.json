    "babel-plugin-import": "^1.13.6",
    "core-js": "^3.30.1",
    "dayjs": "^1.11.7",
    "echarts": "^4.9.0",
    "element-ui": "^2.15.14",
    "html2canvas": "^1.4.1",
    "html2pdf.js": "^0.10.3",
    "js-base64": "^3.7.2",
    "js-cookie": "^2.2.1",
    "js-file-download": "^0.4.12",
    "link-sdk": "^1.0.12",
    "link-ui": "^1.0.39",
    "lodash": "^4.17.21",
    "normalize.css": "^8.0.1",
    "numeral": "^2.0.6",
    "path-to-regexp": "^2.4.0",
    "postcss": "^8.5.6",
    "qs": "^6.11.0",
    "sortablejs": "^1.15.0",
